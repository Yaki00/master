# Copier vers deploy/master-panel/.env sur le VPS — ne pas commiter

MASTER_AUTH_PASSWORD=
MASTER_AUTH_EMAIL=bouchaouradam@gmail.com
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://master.pixelbrain.fr
DOCKER_SOCKET=/var/run/docker.sock
MASTER_DB_PATH=/data/master.db
MASTER_PUBLIC_URL=https://master.pixelbrain.fr

# PixelbrainCard SAV (compte PlatformAdmin)
PIXELBRAIN_API_URL=https://api.card.pixelbrain.fr/api
PIXELBRAIN_PLATFORM_EMAIL=
PIXELBRAIN_PLATFORM_PASSWORD=

# Workers PC / Cursor (+ bureau OpenClaw via WORKER_TOKEN)
WORKER_TOKEN=
CURSOR_API_KEY=
CURSOR_CLOUD_REPOS=
CURSOR_MODEL=composer-2.5

# Revenus Stripe (metadata app_id sur product/price/subscription)
STRIPE_SECRET_KEY=

# Optionnel — endpoints stats custom (header X-Master-Token)
MASTER_STATS_TOKEN=

# Mail IMAP (ou wizard chat → SQLite chiffré + Infisical)
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=
MAIL_IMAP_PASS=
MAIL_IMAP_SECURE=1

# Infisical (sync secrets mail depuis le wizard)
INFISICAL_SITE_URL=https://secrets.pixelbrain.fr
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV_SLUG=prod
INFISICAL_SECRET_PATH=/
